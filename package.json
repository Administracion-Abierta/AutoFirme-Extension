{
	"name": "autofirme-extension",
	"version": "0.2.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": "24.x"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build:extension": "node scripts/build-extension.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.extension.json",
		"check:extension": "node scripts/check-extension.mjs",
		"test": "vitest run && node --test extension/tests/*.test.js && node --test scripts/check-extension.test.mjs && node --test scripts/release-workflow.test.mjs",
		"test:extension:unit": "node --test extension/tests/*.test.js",
		"test:extension:browser": "node scripts/test-extension-browser.mjs",
		"test:extension:artifacts": "node --test scripts/check-extension.test.mjs",
		"package:extension": "python3 scripts/package-extension.py",
		"check:versions": "node scripts/check-versions.mjs",
		"demo:chromium": "playwright install chromium",
		"demo:registradores": "node demo/registradores.mjs"
	},
	"devDependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.77.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"jsdom": "^30.1.2",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.65.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.5",
		"fflate": "^0.8.3",
		"pdf-lib": "npm:@cantoo/pdf-lib@^2.11.1"
	},
	"description": "AutoFirme Chrome MV3 extension — client-side signing for portal AutoScript calls"
}