{
	"include": [
		"extension",
		"scripts",
		"demo"
	],
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"checkJs": true,
		"strict": true,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"noEmit": true,
		"paths": {
			"#lib/*": [
				"./src/lib/*"
			]
		},
		"allowImportingTsExtensions": true
	},
	"files": [
		"types.d.ts"
	]
}